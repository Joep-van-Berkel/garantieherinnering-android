<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.NieuweAankoopActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Label for Product Input Field -->
        <TextView
            android:id="@+id/textViewProductLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp" />

        <!-- Product Input Field -->
        <EditText
            android:id="@+id/inputProduct"
            style="@style/CustomEditTextStyle"
            android:layout_width="0dp"
            android:hint="Vul hier het product in.."
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            app:layout_constraintTop_toBottomOf="@id/textViewProductLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label for Categorie Dropdown -->
        <TextView
            android:id="@+id/textViewCategorieLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categorie"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/inputProduct"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Categorie Dropdown -->
        <Spinner
            android:id="@+id/dropdownCategorie"
            style="@style/CustomSpinnerStyle"
            android:layout_width="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:prompt="@string/prompt_select_categorie"
            app:layout_constraintTop_toBottomOf="@id/textViewCategorieLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label for Aankoopbedrag Input Field -->
        <TextView
            android:id="@+id/textViewAankoopbedragLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aankoopbedrag (€)"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/dropdownCategorie"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Aankoopbedrag Input Field -->
        <EditText
            android:id="@+id/inputAankoopbedrag"
            style="@style/CustomEditTextStyle"
            android:layout_width="0dp"
            android:hint="Vul hier het aankoopbedrag in.."
            android:inputType="number"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/textViewAankoopbedragLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label for Aankoopdatum DatePicker -->
        <TextView
            android:id="@+id/textViewAankoopdatumLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aankoopdatum"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/inputAankoopbedrag"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Aankoopdatum DatePicker -->
        <EditText
            android:id="@+id/inputAankoopdatum"
            style="@style/CustomDatePickerStyle"
            android:layout_width="0dp"
            android:hint="Selecteer de aankoopdatum"
            android:focusable="false"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/textViewAankoopdatumLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label for Dagen Garantie Dropdown -->
        <TextView
            android:id="@+id/textViewDagenGarantieLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dagen Garantie"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/inputAankoopdatum"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Dagen Garantie Dropdown -->
        <Spinner
            android:id="@+id/dropdownDagenGarantie"
            style="@style/CustomSpinnerStyle"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:prompt="@string/prompt_select_garantietermijn"
            app:layout_constraintTop_toBottomOf="@id/textViewDagenGarantieLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Extra Input Field (Initially Hidden) -->
        <EditText
            android:id="@+id/inputExtra"
            style="@style/CustomEditTextStyle"
            android:layout_width="match_parent"
            android:hint="Vul hier het aantal dagen in.."
            android:inputType="numberDecimal"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/dropdownDagenGarantie"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/fotoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Foto's (optioneel)"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/inputExtra"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Foto Picker -->
        <Button
            android:id="@+id/buttonFotoPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toevoegen"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/fotoLabel"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- LinearLayout for displaying selected images -->
        <LinearLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/buttonFotoPicker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/notificatiesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificaties (optioneel)"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imageContainer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- LinearLayout for Checkboxes -->
        <LinearLayout
            android:id="@+id/checkboxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/notificatiesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- CheckBox 1 -->
            <CheckBox
                android:id="@+id/checkbox1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 dag vóór einddatum"
                android:layout_marginTop="1dp" />

            <!-- CheckBox 2 -->
            <CheckBox
                android:id="@+id/checkbox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 week vóór einddatum"
                android:layout_marginTop="1dp" />

            <!-- CheckBox 3 -->
            <CheckBox
                android:id="@+id/checkbox3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 maand vóór einddatum"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- Aanmaken Button -->
        <Button
            android:id="@+id/buttonAanmaken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aanmaken"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/checkboxContainer"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Spacer View to add extra space at the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/buttonAanmaken" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>